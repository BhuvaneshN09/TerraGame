{
  "name": "fallship",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/unit/*.test.js",
    "test:browser:install": "node scripts/browser.mjs install",
    "test:browser": "npm run build && node scripts/browser.mjs test",
    "check": "node scripts/check.mjs && npm test && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "vite": "8.3.4"
  }
}
